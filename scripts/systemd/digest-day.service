[Unit]
Description=Cardine digest-day (fetch + catch-up + weekbrief)
After=network-online.target
Wants=network-online.target

# Het pad is relabelbaar: install-digest-timers.sh vult de echte repo-root in
# en schrijft de unit naar ~/.config/systemd/user/. Er is geen tweede repo meer;
# bron/ en data/ leven in deze repo.
[Service]
Type=oneshot
WorkingDirectory=@REPO_ROOT@
ExecStart=/usr/bin/make digest-day
StandardOutput=append:@REPO_ROOT@/data/external/digest/cron.log
StandardError=append:@REPO_ROOT@/data/external/digest/cron.log
