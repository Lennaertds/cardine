[Unit]
Description=IDE_Agentic digest-week (propose + AE bron/weken)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ventje/Student_Zelfstandige/IDE_Agentic
ExecStart=/usr/bin/make digest-week
StandardOutput=append:/home/ventje/Student_Zelfstandige/IDE_Agentic/data/external/digest/cron.log
StandardError=append:/home/ventje/Student_Zelfstandige/IDE_Agentic/data/external/digest/cron.log
