#!/usr/bin/env bash
# cardine CLI — the only command an empty directory needs.
#
#   npm i -g cardine            → `cardine <dir>` lays down the structure
#
# The structure comes from kit/, shipped inside this package (mirrored from the
# repo's kit/, ADR 0013). Nothing is written outside <dir>.
set -euo pipefail

# npm links bin/ into ../lib/node_modules/<pkg>/bin/<name>; BASH_SOURCE[0] is that
# symlink. Resolve it first, or ROOT is wrong and the CLI cannot find the kit.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "${SELF}")/.." && pwd)"
KIT="${ROOT}/kit"
NEW_PROJECT="${KIT}/new-project.sh"

usage() {
  cat <<'USAGE'
Usage: cardine <dir> [options]

  Lays down the Cardine project structure in <dir>. Never overwrites an existing
  file; a second run is a no-op.

  --profile NAME     app (default) | research | studie | schoolwerk
  --team             team layer instead of solo
  --modules a,b      extra modules
  --stacks a,b       stacks (next, nest, python, sql, rust, c)
  --starter          also the stacks' starter code
  --name NAME        project name for {{PROJECT}} (default: the directory name)
  --dry-run          show what would happen, change nothing
  --no-git           skip git init
  -h, --help         this help

Subcommands:
  status [opts]      status of the lab environment (--json, --verbose, --fix)
  version            version of this package

Examples:
  cardine my-project
  cardine ~/code/api --profile app --stacks python,sql --starter
  cardine exercises --profile schoolwerk --dry-run
USAGE
}

if [ ! -f "$NEW_PROJECT" ]; then
  echo "cardine: kit not found at $NEW_PROJECT (incomplete installation)" >&2
  echo "         reinstall: npm i -g cardine" >&2
  exit 1
fi

case "${1:-}" in
  -h | --help | help | "")
    usage
    exit 0
    ;;
  version)
    node -p "require('${ROOT}/package.json').version"
    exit 0
    ;;
  status | lab)
    # Lab is a separate package with its own command; `cardine` only points at it,
    # because forwarding would need @lennaertds/cardine-lab to be installed.
    echo "cardine: '$1' belongs to @lennaertds/cardine-lab" >&2
    echo "         npm i -g @lennaertds/cardine-lab && cardine-lab $1" >&2
    exit 1
    ;;
  -*)
    echo "cardine: option '$1' without a target directory" >&2
    usage >&2
    exit 1
    ;;
esac

exec bash "$NEW_PROJECT" "$@"
