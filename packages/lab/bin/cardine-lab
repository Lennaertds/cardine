#!/usr/bin/env bash
# cardine-lab CLI — entrypoint of the published package.
#
# Does nothing beyond calling the scripts in this package with absolute paths,
# so that `npm i -g @lennaertds/cardine-lab` works from any cwd.
#
#   cardine-lab install [--force]   → install-lab.sh (idempotent)
#   cardine-lab move [opts]         → cardine-move.sh (the project moved; --fix)
#   cardine-lab status [opts]       → cardine-status.sh (--json, --verbose, --fix)
set -euo pipefail

# Same trap as bin/cardine: through the npm symlink BASH_SOURCE[0] is the link in
# <prefix>/bin, not the file inside the package.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
LAB_DIR="$(cd "$(dirname "${SELF}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage: cardine-lab <command> [options]

  install             set up the lab environment for the current directory
                      (idempotent: a second run only changes what is still off).
  move [opts]         the project moved: re-point the profile and repair the
                      client. Options: --fix  (without: dry run)  --skip-index
  status [opts]       status of the environment. Options: --json --verbose --fix
  version             version of this package
  -h, --help          this help

Examples:
  cardine-lab install
  cardine-lab move --fix
  cardine-lab status --verbose
  cardine-lab status --fix
USAGE
}

case "${1:-}" in
  install)
    shift
    exec bash "${LAB_DIR}/install-lab.sh" "$@"
    ;;
  move)
    shift
    exec bash "${LAB_DIR}/cardine-move.sh" "$@"
    ;;
  status)
    shift
    exec bash "${LAB_DIR}/cardine-status.sh" "$@"
    ;;
  version)
    node -p "require('${LAB_DIR}/package.json').version"
    ;;
  -h | --help | help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
