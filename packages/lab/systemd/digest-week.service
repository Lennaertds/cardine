[Unit]
Description=Cardine digest-week (propose + AE bron/weken)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Pas WorkingDirectory aan naar de lokale clone, bv. /home/jouwgebruiker/cardine
WorkingDirectory=/home/_jouwgebruiker_/cardine
ExecStart=/usr/bin/make digest-week
# Pas log-pad aan naar de lokale clone
StandardOutput=append:/home/_jouwgebruiker_/cardine/data/external/digest/cron.log
StandardError=append:/home/_jouwgebruiker_/cardine/data/external/digest/cron.log
