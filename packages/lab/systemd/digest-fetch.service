[Unit]
Description=Cardine digest-fetch (arXiv RSS)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ventje/Student_Zelfstandige/cardine
ExecStart=/usr/bin/make digest-fetch
StandardOutput=append:/home/ventje/Student_Zelfstandige/cardine/data/external/digest/cron.log
StandardError=append:/home/ventje/Student_Zelfstandige/cardine/data/external/digest/cron.log
