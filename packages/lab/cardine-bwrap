#!/usr/bin/env bash
# Strakkere kooi dan de DSH-bwrap-profiel. DSH geeft --ro-bind / / mee;
# die regel maakt ~/.ssh leesbaar. Dit script leest die argumenten en
# mount alleen /usr, /etc en de workspace. ADR 0007.
#
# Binnen de workspace maskeert het .env, SSH-keys en certificaten, zodat
# de agent ze niet kan lezen of overschrijven. Bewijs: make sandbox-secrets.
set -euo pipefail

binds=()
declare -A workspaces=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      break
      ;;
    --bind)
      binds+=("$2" "$3")
      shift 3
      ;;
    --ro-bind)
      shift 3
      ;;
    --dev|--proc|--tmpfs)
      shift 2
      ;;
    --unshare-pid|--die-with-parent)
      shift
      ;;
    *)
      echo "bwrap: cardine-bwrap begrijpt '$1' niet" >&2
      exit 1
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  echo "bwrap: cardine-bwrap kreeg geen commando" >&2
  exit 1
fi

HOME_DIR="${HOME:?HOME niet gezet — kan niet bepalen waar .dsh/ .local/ .jarvis/ staan}"

# Zorg dat ~/.dsh/ bestaat vóór bwrap hem kan binden (anders faalt --bind).
mkdir -p "${HOME_DIR}/.dsh" "${HOME_DIR}/.dsh/profiles" "${HOME_DIR}/.dsh/profiles/acp" 2>/dev/null || true

args=(
  --ro-bind /usr /usr
  --symlink usr/bin /bin
  --symlink usr/lib /lib
  --symlink usr/lib /lib64
  --ro-bind /etc /etc
  --ro-bind "${HOME_DIR}/.local" "${HOME_DIR}/.local"
  --ro-bind "${HOME_DIR}/.jarvis" "${HOME_DIR}/.jarvis"
  # DSH-home persistent maken (schrijfbaar) zodat het profiel bewaard blijft
  --bind "${HOME_DIR}/.dsh" "${HOME_DIR}/.dsh"
  --dev /dev
  --proc /proc
  --unshare-pid
  --die-with-parent
  --tmpfs /tmp
  --setenv PATH "/usr/bin:/bin:${HOME_DIR}/.local/bin:${HOME_DIR}/.jarvis/bin"
)

declare -A made=()
add_dirs() {
  local path="$1"
  local part=""
  local IFS=/
  local -a bits=()
  read -r -a bits <<< "${path#/}"
  for bit in "${bits[@]}"; do
    part+="/$bit"
    if [[ -z "${made[$part]+x}" ]]; then
      args+=(--dir "$part")
      made[$part]=1
    fi
  done
}

if [[ ${#binds[@]} -gt 0 ]]; then
  for ((i = 0; i < ${#binds[@]}; i += 2)); do
    src="${binds[$i]}"
    dest="${binds[$((i + 1))]}"
    # Ouders aanmaken, het doel zelf niet: --bind vult die.
    parent="${dest%/*}"
    if [[ -n "$parent" && "$parent" != "$dest" ]]; then
      add_dirs "$parent"
    fi
    args+=(--bind "$src" "$dest")
    workspaces["$dest"]=1
  done

  # Secrets binnen de workspace afschermen (ADR 0007: "zonder .env").
  # Eerst een lege overlay NA de --bind: alle writes (ook rm en nieuwe
  # bestanden) landen in een tmpfs en raken de host niet. Zonder deze stap
  # schrijft de shell hieronder naar de echte .env.
  for mountpoint in "${!workspaces[@]}"; do
    if [[ -d "$mountpoint" ]]; then
      args+=(--overlay-src "$mountpoint" --tmp-overlay "$mountpoint")
    fi
  done

  # Dan .env/.env.* (behalve *.example), SSH-keys en certificaten maskeren.
  # Uitzetten bewust: CARDINE_BWRAP_ALLOW_SECRETS=1 (bv. debuggen); standaard dicht.
  if [[ "${CARDINE_BWRAP_ALLOW_SECRETS:-0}" != "1" ]]; then
    secrets=()
    for mountpoint in "${!workspaces[@]}"; do
      [[ -d "$mountpoint" ]] || continue
      while IFS= read -r -d '' file; do
        case "$file" in
          *.example) continue ;;  # nieuwe variabelen blijven documenteerbaar
        esac
        secrets+=("$file")
      done < <(find "$mountpoint" \
                 \( -name '*.env' -o -name '*.env.*' -o -name 'id_rsa' \
                    -o -name 'id_ed25519' -o -name 'id_ecdsa' -o -name 'id_dsa' \
                    -o -name '*.pem' -o -name '*.p12' -o -name '*.pfx' \) \
                 -type f -print0 2>/dev/null)
    done

    if [[ ${#secrets[@]} -gt 0 ]]; then
      # Shell: een bind van /dev/null over elke secret, in de overlay, dus
      # de host blijft intact. Lezen en schrijven falen (Permission denied),
      # het pad blijft bestaan (geen ENOENT).
      for f in "${secrets[@]}"; do
        args+=(--bind /dev/null "$f")
      done
    fi
  fi
fi

exec bwrap "${args[@]}" -- "$@"
