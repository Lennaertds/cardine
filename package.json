{
  "name": "cardine",
  "version": "0.4.1",
  "private": false,
  "description": "Cardine — projectstructuur voor ieder project. `npx cardine <map>` zet de bewezen boom neer; het lab-werkstation zit in @lennaertds/cardine-lab.",
  "scripts": {
    "status": "bash packages/lab/cardine-status.sh",
    "status:json": "bash packages/lab/cardine-status.sh --json",
    "verbose": "bash packages/lab/cardine-status.sh --verbose",
    "install-lab": "bash packages/lab/install-lab.sh",
    "check": "make check",
    "finish": "make finish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lennaertds/cardine.git"
  },
  "license": "MIT",
  "keywords": [
    "cardine",
    "agent-engineering",
    "project-structure",
    "ai-agent",
    "workspace"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "bin": {
    "cardine": "bin/cardine"
  },
  "files": [
    "bin/",
    "packages/structure/kit/",
    "packages/structure/README.md",
    "packages/structure/CHANGELOG.md",
    "packages/lab/install-lab.sh",
    "packages/lab/bin/",
    "packages/lab/cardine-bwrap",
    "packages/lab/cardine-status.sh",
    "packages/lab/cardine-slice-check/",
    "packages/lab/cardine-secrets-guard/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
